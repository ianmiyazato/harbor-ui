---
import '../styles/global.css';
import bricolage from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url';
import geist from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import Logo from '../components/Logo.astro';
import ThemeSwitcher from '../components/ThemeSwitcher.astro';
import { nav, site } from '../site';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.pitch } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name}: an accessible, token-driven design system`;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- The two faces that set the first screen: preloaded so text does not re-wrap when they swap in. -->
    <link rel="preload" href={bricolage} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geist} as="font" type="font/woff2" crossorigin />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      // Apply a saved theme before the first paint so there is no flash.
      try {
        const t = localStorage.getItem('hb-theme');
        if (t === 'light' || t === 'dark' || t === 'hc') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container bar">
        <a class="brand" href="/">
          <Logo />
          <span>Harbor</span>
        </a>
        <nav aria-label="Primary">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <ThemeSwitcher />
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <p>
          Harbor UI is a portfolio project by Ian Miyazato. MIT licensed.
          <a href={site.repo}>Source on GitHub</a>.
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    inset-block-start: var(--hb-space-2);
    inset-inline-start: var(--hb-space-2);
    z-index: var(--hb-z-tooltip);
    padding: var(--hb-space-2) var(--hb-space-3);
    border-radius: var(--hb-radius-md);
    background-color: var(--hb-color-action-primary);
    color: var(--hb-color-text-on-action);
    font-weight: var(--hb-font-weight-semibold);
    transform: translateY(-200%);
  }

  .skip:focus-visible {
    transform: none;
  }

  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: var(--hb-z-popover);
    border-block-end: var(--hb-border-width-thin) solid var(--hb-color-border-default);
    background-color: color-mix(in srgb, var(--hb-color-surface-default) 88%, transparent);
    backdrop-filter: blur(12px);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--hb-space-3) var(--hb-space-6);
    min-height: calc(var(--hb-size-control-lg) + var(--hb-space-3));
    padding-block: var(--hb-space-2);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--hb-space-2);
    color: var(--hb-color-text-default);
    font-family: var(--hb-font-family-display);
    font-size: var(--hb-font-size-lg);
    line-height: var(--hb-font-leading-lg);
    font-weight: var(--hb-font-weight-bold);
    letter-spacing: var(--hb-font-tracking-tight);
    text-decoration: none;
  }

  nav {
    margin-inline-end: auto;
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--hb-space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-height: var(--hb-size-control-sm);
    padding-inline: var(--hb-space-3);
    border-radius: var(--hb-radius-md);
    color: var(--hb-color-text-muted);
    font-size: var(--hb-font-size-md);
    font-weight: var(--hb-font-weight-medium);
    text-decoration: none;
  }

  nav a:hover {
    background-color: var(--hb-color-action-ghost-hover);
    color: var(--hb-color-text-default);
  }

  nav a[aria-current='page'] {
    color: var(--hb-color-text-default);
    box-shadow: inset 0 calc(-1 * var(--hb-border-width-thick)) 0 var(--hb-color-action-primary);
  }

  main {
    min-height: 70vh;
    padding-block-end: var(--hb-space-16);
  }

  main:focus {
    outline: none;
  }

  .site-footer {
    padding-block: var(--hb-space-8);
    border-block-start: var(--hb-border-width-thin) solid var(--hb-color-border-default);
    color: var(--hb-color-text-muted);
    font-size: var(--hb-font-size-sm);
    line-height: var(--hb-font-leading-sm);
  }
</style>
