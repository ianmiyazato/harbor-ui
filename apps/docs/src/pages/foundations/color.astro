---
import { Badge } from '@ianmiyazato/harbor-react';
import Base from '../../layouts/Base.astro';
import { contrast, inkFor, resolve, themeLabels, tokens } from '../../lib/tokens';
import type { ThemeName } from '../../lib/tokens';

const themes: ThemeName[] = ['light', 'dark', 'hc'];
const palette = tokens.filter((t) => t.tier === 'primitive' && !String(t.value).match(/^#[0-9A-F]{8}$/));
const scales = [...new Set(palette.map((t) => t.name.split('.')[1] as string))].map((scale) => ({
  scale,
  steps: palette.filter((t) => t.name.split('.')[1] === scale),
}));
const semantic = tokens.filter((t) => t.tier === 'semantic' && t.category === 'color');
const { summary, byTheme, results } = contrast;
const kindLabel = { text: 'Body text', 'large-text': 'Large text', ui: 'UI boundary' } as const;
---

<Base title="Color" description="Harbor's palette, semantic color tokens per theme and the generated WCAG contrast report.">
  <div class="container page-header">
    <p class="eyebrow">Foundations · Color</p>
    <h1>Color</h1>
    <p class="lede">
      Primitives are OKLCH-derived scales around teal <code>#1F6F5C</code>. Components never touch
      them: they read {semantic.length} semantic colors, and each theme maps those names to
      different primitives.
    </p>
  </div>

  <section class="container section" aria-labelledby="palette">
    <h2 id="palette">Palette (private primitives)</h2>
    {
      scales.map(({ scale, steps }) => (
        <div class="scale">
          <h3 class="scale-name">{scale}</h3>
          <ul class="swatches" aria-label={`${scale} scale`}>
            {steps.map((t) => (
              <li class="swatch" style={`background:${t.value};color:${inkFor(String(t.value))}`}>
                <span class="step">{t.name.split('.')[2]}</span>
                <span class="hex">{String(t.value)}</span>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </section>

  <section class="container section" aria-labelledby="semantic">
    <h2 id="semantic">Semantic colors (the public API)</h2>
    <p class="note">Same name in every theme; only the mapping changes.</p>
    <div class="table-wrap">
      <table>
        <caption class="visually-hidden">Semantic color tokens and their value per theme</caption>
        <thead>
          <tr>
            <th scope="col">Token</th>
            {themes.map((th) => <th scope="col">{themeLabels[th]}</th>)}
          </tr>
        </thead>
        <tbody>
          {
            semantic.map((t) => (
              <tr>
                <th scope="row">
                  <code>{t.name.replace('color.', '')}</code>
                  <span class="desc">{t.description}</span>
                </th>
                {themes.map((th) => {
                  const hex = resolve(t.name, th);
                  return (
                    <td>
                      <span class="chip" style={`background:${hex}`} />
                      <code>{hex}</code>
                    </td>
                  );
                })}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section class="container section" aria-labelledby="contrast">
    <h2 id="contrast">Contrast report</h2>
    <p class="note">
      Generated by the token test suite (<code>packages/tokens/test/contrast.test.ts</code>) from
      every foreground/background pair the components render. CI fails if any pair drops below
      4.5:1 for text or 3:1 for large text and UI boundaries. Ratios are rounded down.
    </p>
    <dl class="summary" data-testid="contrast-summary">
      <div><dt>Pairs</dt><dd>{summary.pairs} pairs</dd></div>
      <div><dt>Checks</dt><dd>{summary.checks} checks</dd></div>
      <div><dt>Passing</dt><dd>{summary.passed} passed ({Math.round(summary.passRate * 100)}%)</dd></div>
      {
        themes.map((th) => (
          <div>
            <dt>Lowest, {themeLabels[th]}</dt>
            <dd>{byTheme[th].minRatio.toFixed(2)}:1</dd>
          </div>
        ))
      }
    </dl>
    {
      themes.map((th) => (
        <div class="table-wrap">
          <table>
            <caption>{themeLabels[th]} theme</caption>
            <thead>
              <tr>
                <th scope="col">Sample</th>
                <th scope="col">Foreground on background</th>
                <th scope="col">Kind</th>
                <th scope="col">Ratio</th>
                <th scope="col">Needs</th>
                <th scope="col">Result</th>
              </tr>
            </thead>
            <tbody>
              {results
                .filter((r) => r.theme === th)
                .map((r) => (
                  <tr data-contrast-row data-theme-name={r.theme} data-fg={r.fg} data-bg={r.bg}>
                    <td>
                      <span class="sample" style={`color:${r.fgHex};background:${r.bgHex}`} aria-hidden="true">
                        {r.kind === 'ui' ? '◼' : 'Aa'}
                      </span>
                    </td>
                    <td>
                      <code>{r.fg.replace('color.', '')}</code> on <code>{r.bg.replace('color.', '')}</code>
                      <span class="desc">{r.usedBy.join(', ')}</span>
                    </td>
                    <td>{kindLabel[r.kind as keyof typeof kindLabel]}</td>
                    <td class="num">{r.ratio.toFixed(2)}:1</td>
                    <td class="num">{r.required}:1</td>
                    <td>
                      <Badge tone={r.pass ? 'success' : 'danger'} size="sm">
                        {r.pass ? 'Pass' : 'Fail'}
                      </Badge>
                    </td>
                  </tr>
                ))}
            </tbody>
          </table>
        </div>
      ))
    }
  </section>
</Base>

<style>
  .note {
    max-width: 44rem;
    color: var(--hb-color-text-muted);
  }

  .scale {
    display: grid;
    gap: var(--hb-space-2);
  }

  .scale-name {
    font-family: var(--hb-font-family-code);
    font-size: var(--hb-font-size-sm);
    text-transform: capitalize;
  }

  .swatches {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(5.5rem, 1fr));
    gap: var(--hb-space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .swatch {
    display: grid;
    gap: var(--hb-space-1);
    min-height: var(--hb-space-16);
    padding: var(--hb-space-2);
    border-radius: var(--hb-radius-sm);
    box-shadow: inset 0 0 0 var(--hb-border-width-thin) var(--hb-color-border-default);
    font-family: var(--hb-font-family-code);
    font-size: var(--hb-font-size-xs);
    line-height: var(--hb-font-leading-xs);
    align-content: end;
  }

  .step {
    font-weight: var(--hb-font-weight-semibold);
  }

  .table-wrap {
    overflow-x: auto;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--hb-font-size-md);
    line-height: var(--hb-font-leading-md);
  }

  caption {
    padding-block: var(--hb-space-4) var(--hb-space-2);
    font-family: var(--hb-font-family-display);
    font-size: var(--hb-font-size-lg);
    font-weight: var(--hb-font-weight-semibold);
    text-align: start;
  }

  th,
  td {
    padding: var(--hb-space-2) var(--hb-space-3);
    border-block-end: var(--hb-border-width-thin) solid var(--hb-color-border-default);
    text-align: start;
    vertical-align: middle;
  }

  thead th {
    color: var(--hb-color-text-muted);
    font-size: var(--hb-font-size-sm);
    font-weight: var(--hb-font-weight-medium);
  }

  tbody th {
    font-weight: var(--hb-font-weight-regular);
  }

  .desc {
    display: block;
    color: var(--hb-color-text-muted);
    font-size: var(--hb-font-size-sm);
  }

  .chip {
    display: inline-block;
    width: var(--hb-size-icon-md);
    height: var(--hb-size-icon-md);
    margin-inline-end: var(--hb-space-2);
    border-radius: var(--hb-radius-sm);
    box-shadow: inset 0 0 0 var(--hb-border-width-thin) var(--hb-color-border-strong);
    vertical-align: middle;
  }

  td code,
  th code {
    font-size: var(--hb-font-size-sm);
  }

  .sample {
    display: inline-grid;
    place-items: center;
    width: var(--hb-size-control-md);
    height: var(--hb-size-control-sm);
    border-radius: var(--hb-radius-sm);
    box-shadow: inset 0 0 0 var(--hb-border-width-thin) var(--hb-color-border-default);
    font-weight: var(--hb-font-weight-semibold);
  }

  .num {
    font-family: var(--hb-font-family-code);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .summary {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: var(--hb-space-3);
    margin: 0;
  }

  .summary div {
    padding: var(--hb-space-4);
    border: var(--hb-border-width-thin) solid var(--hb-color-border-default);
    border-radius: var(--hb-radius-lg);
    background-color: var(--hb-color-surface-raised);
  }

  .summary dt {
    color: var(--hb-color-text-muted);
    font-size: var(--hb-font-size-sm);
  }

  .summary dd {
    margin: 0;
    font-family: var(--hb-font-family-display);
    font-size: var(--hb-font-size-xl);
    line-height: var(--hb-font-leading-xl);
    font-weight: var(--hb-font-weight-semibold);
  }
</style>
