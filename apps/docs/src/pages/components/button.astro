---
import ComponentPage from '../../layouts/ComponentPage.astro';
import { Do, Dont, Playground } from '../../demos/button';
---

<ComponentPage slug="button">
  <Playground slot="demo" client:visible />
  <Do slot="do" />
  <Fragment slot="do-caption">One primary action; everything else is secondary or ghost.</Fragment>
  <Dont slot="dont" />
  <Fragment slot="dont-caption">Two primaries compete, so neither reads as the main action.</Fragment>
</ComponentPage>
