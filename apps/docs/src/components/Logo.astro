---
/** Harbor mark: a breakwater arc sheltering calm water. */
---

<svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true" class="mark">
  <rect width="32" height="32" rx="8" fill="var(--hb-color-action-primary)"></rect>
  <path d="M7 18a9 9 0 0 1 18 0" fill="none" stroke="var(--hb-color-text-on-action)" stroke-width="2.5" stroke-linecap="round"></path>
  <path d="M9 23c2.3 0 2.3-1.5 4.6-1.5S15.9 23 18.2 23s2.3-1.5 4.8-1.5" fill="none" stroke="var(--hb-color-text-on-action)" stroke-width="2" stroke-linecap="round"></path>
</svg>

<style>
  .mark {
    flex: none;
  }
</style>
