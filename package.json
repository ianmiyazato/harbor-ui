{
  "name": "harbor-ui",
  "private": true,
  "description": "Harbor UI: an accessible, token-driven design system with a micro-interaction lab",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@harbor/docs...",
    "build": "turbo run build",
    "preview": "pnpm --filter @harbor/docs preview",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project infra --project tokens",
    "test:a11y": "vitest run --project a11y --passWithNoTests",
    "check": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:a11y && pnpm build",
    "format": "prettier --write .",
    "deploy:prod": "vercel deploy --prod"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.11"
  }
}
