{
  "name": "harbor-ui",
  "private": true,
  "description": "Harbor UI: an accessible, token-driven design system with a micro-interaction lab",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@harbor/docs...",
    "build": "turbo run build",
    "preview": "pnpm --filter @harbor/docs preview",
    "lint": "eslint . --max-warnings=0 && stylelint \"packages/react/src/**/*.css\" --allow-empty-input && prettier --check . --log-level warn",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project infra --project tokens --project react",
    "test:a11y": "vitest run --project a11y --passWithNoTests",
    "test:e2e": "playwright test --project=e2e",
    "verify:prod": "BASE_URL=https://harbor-ui-docs.vercel.app playwright test --project=e2e tests/e2e/site.spec.ts tests/e2e/theme.spec.ts",
    "test:visual": "playwright test --project=visual",
    "check": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:a11y && pnpm build",
    "size": "pnpm --filter @ianmiyazato/harbor-react size",
    "format": "prettier --write .",
    "deploy:prod": "vercel deploy --prod"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.9.9",
    "stylelint": "^16.26.1",
    "turbo": "^2.11.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.11"
  }
}
