{
  "name": "@ianmiyazato/harbor-react",
  "version": "0.0.0",
  "description": "Harbor UI React components: accessible, token-driven, zero-runtime styling.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./states": {
      "types": "./dist/states.d.ts",
      "default": "./dist/states.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ianmiyazato/harbor-ui.git",
    "directory": "packages/react"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@ianmiyazato/harbor-tokens": "workspace:^",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.13.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^7.3.6"
  }
}
